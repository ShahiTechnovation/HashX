# ==============================================================================
# HashX backend — PRIVATE configuration (never commit real values)
# ==============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Number of trusted reverse-proxy hops (e.g. 1 behind Caddy). Leave unset when not behind a proxy;
# forwarded headers are otherwise ignored for client IPs.
TRUST_PROXY=1

# PostgreSQL (required in production). Apply schema with: pnpm --prefix server db:migrate:prod
DATABASE_URL=postgresql://hashx:CHANGE_ME@localhost:5432/hashx

# Browser origins allowed to call the API (https only in production), and SIWE domains (host[:port]).
ALLOWED_ORIGINS=https://hashx-a2a.vercel.app
SIWE_ALLOWED_DOMAINS=hashx-a2a.vercel.app
SESSION_TTL_SECONDS=3600
SIWE_NONCE_TTL_SECONDS=300

# Ethereum Sepolia (11155111). Use your own provider URL; it is never exposed by the API.
SEPOLIA_RPC_URL=
SEPOLIA_PAYMENTS_ENABLED=true
# "confirmations:<n>" or "finalized"
SEPOLIA_FINALITY_POLICY=confirmations:12
# Set ONLY after a verified deployment (deployments/sepolia.json); readiness re-checks code + VERSION().
EVIDENCE_REGISTRY_ADDRESS_SEPOLIA=

# HashKey Chain (delivery verification only in this release; payments via HSP are not connected)
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
EVIDENCE_REGISTRY_ADDRESS_TESTNET=
EVIDENCE_REGISTRY_ADDRESS_MAINNET=

# Verification bounds
DELIVERY_MAX_BLOCK_RANGE=50
DELIVERY_MIN_CONFIRMATIONS=6
RPC_TIMEOUT_MS=8000
DELIVERY_VERIFICATION_TIMEOUT_MS=45000
VERIFICATION_TTL_SECONDS=86400

# Payments
PAYMENT_AUTHORIZATION_TTL_SECONDS=900
PAYMENT_DROP_TIMEOUT_SECONDS=1800
RECONCILE_INTERVAL_MS=15000

# Rate limits (per client IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_WRITE=120

# HashKey HSP (fail-closed). Execution stays unavailable until a real connection, tool discovery,
# schema validation AND an officially specified credential scheme exist. Allowlist the backend's
# ACTUAL public egress IP with HSP operations before setting HSP_ALLOWLIST_CONFIRMED=true.
HSP_MCP_STREAMABLE_HTTP_ENDPOINT=
HSP_MERCHANT_NAME=HashX
HSP_APP_KEY=
HSP_APP_SECRET=
HSP_ALLOWLIST_CONFIRMED=false

# --- Local development only (rejected when NODE_ENV=production) ---
# HASHX_ENABLE_LOCAL_CHAIN=true
# LOCAL_RPC_URL=http://127.0.0.1:8545
# LOCAL_SETTLEMENT_TOKEN_ADDRESS=
# LOCAL_FINALITY_POLICY=confirmations:2
# Local DB alternative to DATABASE_URL: DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME
