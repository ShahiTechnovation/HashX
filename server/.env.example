# ==============================================================================
# HashX Persistent Backend — Environment Configuration
# ==============================================================================
# CONFIDENTIAL: NEVER COMMIT THIS FILE WITH REAL PRODUCTION SECRETS.
# All variables here are private to the backend server and must NEVER be exposed
# to the frontend or included in NEXT_PUBLIC_* variables.
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=8080

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://hashx:your_secure_password_here@localhost:5432/hashx_v1
POSTGRES_DB=hashx_v1
POSTGRES_USER=hashx
POSTGRES_PASSWORD=your_secure_password_here

# HashKey Chain RPC Endpoints
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz

# Evidence Registry Contract Address
EVIDENCE_REGISTRY_ADDRESS_TESTNET=0x19B861876D8075A11eC6c4596395b058fe8466C2
EVIDENCE_REGISTRY_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000

# HSP Gateway & MCP Tool Service Credentials
# DO NOT CONNECT until your server's public outbound IP has been allowlisted by HSP Operations!
HSP_MCP_STREAMABLE_HTTP_ENDPOINT=https://qa-hsp.hashkey.com/mcp
HSP_MERCHANT_NAME=HashX
HSP_APP_KEY=your_hsp_app_key_from_operations
HSP_APP_SECRET=your_hsp_app_secret_from_operations
HSP_ALLOWLIST_CONFIRMED=false

