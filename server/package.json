{
  "name": "hashx-backend",
  "version": "1.0.0",
  "private": true,
  "description": "HashX\u00e2\u20ac\u201d Persistent Backend & HSP Payment Integration Service",
  "main": "dist/server/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/server/src/db/migrate.js",
    "verify-receipt": "tsx src/cli/verify-receipt.ts",
    "example:golden-path": "tsx examples/agent-golden-path.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "viem": "^2.23.10",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
