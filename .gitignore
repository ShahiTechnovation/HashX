# ==============================================================================
# HashX Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Project Specific & User Requested
# ------------------------------------------------------------------------------
HashX Global V1 Product Requirements Document.pdf
*.pdf

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.npm/
.yarn/

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# Keep .env.example committed as template, ignore all actual environment secrets
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credentials, keys, certificates
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Production Builds & Bundler Output
# ------------------------------------------------------------------------------
# Next.js
.next/
out/
.turbo/

# General build artifacts (server, packages)
build/
dist/
**/dist/

# TypeScript cache
*.tsbuildinfo
tsconfig.tsbuildinfo
**/*.tsbuildinfo

# ------------------------------------------------------------------------------
# Smart Contracts & Web3 (Hardhat & Foundry)
# ------------------------------------------------------------------------------
contracts/artifacts_hardhat/
contracts/cache_hardhat/
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/typechain/
contracts/typechain-types/
artifacts/
cache/
typechain/
typechain-types/
broadcast/

# ------------------------------------------------------------------------------
# Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*.lcov
.nyc_output/
.vitest/

# ------------------------------------------------------------------------------
# Local Databases & Persistent Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# ------------------------------------------------------------------------------
# Operating System & IDE Specific
# ------------------------------------------------------------------------------
# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs & Editors
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Tool caches
.claude/

# Vercel
.vercel
.vercel

# Local-only deployment records (public-network records under deployments/ are committed)
deployments/localhost.json
deployments/hardhat.json
