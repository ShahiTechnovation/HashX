# ==============================================================================
# HashX frontend (Next.js / Vercel) — PUBLIC configuration only
# ==============================================================================
# Everything here is shipped to browsers. NEVER put private keys, mnemonics,
# HSP credentials, database URLs or API secrets in NEXT_PUBLIC_* variables.

# 'demo' = simulated in-browser fixtures (clearly labelled)
# 'connected' = real persistent backend + wallet sign-in (Sepolia testnet)
NEXT_PUBLIC_OPERATION_MODE=demo

# Persistent HashX backend (server/). Its ALLOWED_ORIGINS / SIWE_ALLOWED_DOMAINS
# must include this site's origin / host.
NEXT_PUBLIC_HASHX_API_URL=http://localhost:8080
