# ==============================================================================
# HashXV1 — Environment Configuration Reference
# ==============================================================================
# DO NOT put raw private keys, merchant secrets, or server tokens into NEXT_PUBLIC_* variables.
# The frontend acts as a verification, presentation, and user-confirmation layer.

# Application Operation Mode ('demo' | 'connected')
NEXT_PUBLIC_OPERATION_MODE=demo

# HashKey Chain Configuration
# Testnet: 133 (https://testnet.hsk.xyz) | Mainnet: 177 (https://mainnet.hsk.xyz)
NEXT_PUBLIC_DEFAULT_CHAIN_ID=133
NEXT_PUBLIC_HSK_TESTNET_RPC=https://testnet.hsk.xyz
NEXT_PUBLIC_HSK_MAINNET_RPC=https://mainnet.hsk.xyz

# HashX Evidence Registry Contract Address
NEXT_PUBLIC_EVIDENCE_REGISTRY_ADDRESS_TESTNET=0x19B861876D8075A11eC6c4596395b058fe8466C2
NEXT_PUBLIC_EVIDENCE_REGISTRY_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000

# Backend Integration (Connected Mode Only)
# When NEXT_PUBLIC_OPERATION_MODE=connected, the frontend routes requests to this API.
NEXT_PUBLIC_HASHX_API_URL=https://api.hashx.global/v1

# HSP Gateway & MCP Tool Service (Backend / Server-Side only)
# HSP QA requires public outbound IP allowlisting via HSP Operations.
# These variables should only be set in the persistent backend environment.
# HSP_MCP_STREAMABLE_HTTP_ENDPOINT=https://qa-hsp.hashkey.com/mcp
# HSP_MERCHANT_NAME=HashX 
# HSP_APP_KEY=
# HSP_APP_SECRET=

